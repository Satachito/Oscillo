<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Sandbox, as the Mac App Store requires, and the three things
     PiLyzer reaches outside it for: a Pico 2 over USB, an ArLyzer's serial
     port, and the CSV file the user names in the save panel. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.device.usb</key><true/>
    <key>com.apple.security.device.serial</key><true/>
    <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
